---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { readingTime, withBase } from '../utils';

type Props = CollectionEntry<'blog'>['data'] & {
	readingTime?: string;
};

const { title, description, pubDate, updatedDate, heroImage, tags, readingTime } =
	Astro.props;
---

<html lang="fr">
	<head>
		<BaseHead title={`${title} — Amikone`} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main class="mx-auto w-full max-w-4xl px-5 pb-24 pt-28">
			<article>
				<nav class="mb-8 text-sm">
					<a
						href={withBase('/blog/')}
						class="inline-flex items-center gap-1.5 text-white/55 no-underline transition hover:text-[color:var(--color-lavender)]"
					>
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M19 12H6M11 6l-6 6 6 6"></path>
						</svg>
						Tous les articles
					</a>
				</nav>

				<header class="text-center">
					<div class="mb-5 flex flex-wrap items-center justify-center gap-2">
						{
							tags.map((tag) => (
								<span class="chip chip-active">{tag}</span>
							))
						}
					</div>

					<h1 class="m-0 text-balance text-[clamp(2rem,5vw,3rem)] leading-[1.1] tracking-tight text-white">
						{title}
					</h1>

					<div
						class="mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[15px] text-white/50"
					>
						<FormattedDate date={pubDate} />
						<span aria-hidden="true">•</span>
						<span>Équipe Amikone</span>
						<span aria-hidden="true">•</span>
						<span>{readingTime ?? '~5 min de lecture'}</span>
					</div>
				</header>

				{
					heroImage && (
						<div class="mt-10 overflow-hidden rounded-glass border border-white/10 shadow-[var(--shadow-card)]">
							<Image
								width={1200}
								height={600}
								src={heroImage}
								alt=""
								class="h-auto w-full"
							/>
						</div>
					)
				}

				<div class="glass-panel mt-10 px-5 py-8 sm:px-10 sm:py-12">
					<div class="prose">
						<slot />
					</div>
				</div>

				<footer class="mt-10 flex flex-col items-center justify-between gap-4 rounded-glass border border-white/10 bg-white/5 px-6 py-5 sm:flex-row">
					<p class="m-0 text-[15px] text-white/60">
						Une question, une idée d'amélioration ?
					</p>
					<a href={withBase('/#download')} class="btn btn-primary py-2.5! text-sm">
						Tester Amikone
					</a>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>
