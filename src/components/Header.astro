---
import { GITHUB_APP_URL } from '../consts';
import { withBase } from '../utils';
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';

const links = [
	{ href: '/', label: 'Accueil' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/about/', label: 'À propos' },
];
---

<header
	class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[rgba(18,18,18,0.72)] backdrop-blur-xl"
>
	<nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
		<a
			href={withBase('/')}
			class="flex items-center gap-2.5 text-white no-underline hover:text-white"
		>
			<Logo size={32} />
			<span class="text-lg font-bold tracking-tight">Amikone</span>
			<span class="chip hidden text-[10px] sm:inline-flex">Open Source</span>
		</a>

		<div class="hidden items-center gap-1 md:flex">
			{
				links.map((link) => (
					<HeaderLink
						href={withBase(link.href)}
						class="rounded-full px-4 py-2 text-[15px] text-white/70 transition hover:bg-white/5 hover:text-white"
					>
						{link.label}
					</HeaderLink>
				))
			}
		</div>

		<div class="hidden items-center gap-2.5 md:flex">
			<a
				href={GITHUB_APP_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white/80 transition hover:border-[rgba(124,77,255,0.6)] hover:text-white"
				aria-label="Code source sur GitHub"
			>
				<svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
					<path
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
					></path>
				</svg>
			</a>
			<a href={withBase('/#download')} class="btn btn-primary px-5! py-2.5! text-sm">
				Télécharger
			</a>
		</div>

		<button
			id="nav-toggle"
			type="button"
			class="flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white md:hidden"
			aria-label="Ouvrir le menu"
			aria-controls="nav-mobile"
			aria-expanded="false"
		>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
				<path d="M4 7h16M4 12h16M4 17h16"></path>
			</svg>
		</button>
	</nav>

	<div id="nav-mobile" class="hidden border-t border-white/10 bg-[rgba(18,18,18,0.96)] px-5 py-4 md:hidden">
		<div class="flex flex-col gap-1">
			{
				links.map((link) => (
					<HeaderLink
						href={withBase(link.href)}
						class="rounded-xl px-4 py-3 text-white/80 transition hover:bg-white/5 hover:text-white"
					>
						{link.label}
					</HeaderLink>
				))
			}
			<a
				href={GITHUB_APP_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="rounded-xl px-4 py-3 text-white/80 transition hover:bg-white/5 hover:text-white"
			>
				Code source
			</a>
			<a href={withBase('/#download')} class="btn btn-primary mt-2"> Télécharger l'application </a>
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const panel = document.getElementById('nav-mobile');

	const setOpen = (open: boolean) => {
		if (!panel || !toggle) return;
		panel.classList.toggle('hidden', !open);
		toggle.setAttribute('aria-expanded', String(open));
	};

	toggle?.addEventListener('click', () => {
		setOpen(panel?.classList.contains('hidden') ?? true);
	});

	panel?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setOpen(false));
	});
</script>
