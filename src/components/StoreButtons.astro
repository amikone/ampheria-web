---
import { APP_STORE_URL, PLAY_STORE_URL } from '../consts';

interface Props {
	class?: string;
	size?: 'sm' | 'lg';
}

const { class: className = '', size = 'lg' } = Astro.props;
const pad = size === 'lg' ? 'px-6 py-4' : 'px-4 py-3';
const iconSize = size === 'lg' ? 26 : 20;
const smallText = size === 'lg' ? 'text-[11px]' : 'text-[10px]';
const bigText = size === 'lg' ? 'text-[17px]' : 'text-[15px]';
---

<div class:list={['flex flex-wrap gap-3', className]}>
	<a
		href={APP_STORE_URL}
		target="_blank"
		rel="noopener noreferrer"
		class:list={['glass-card flex items-center gap-3 no-underline hover:no-underline', pad]}
		aria-label="Télécharger Amikone sur l'App Store"
	>
		<svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="#fff" aria-hidden="true">
			<path
				d="M16.7 12.9c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.7-1.3-.1-2.5.8-3.1.8-.6 0-1.6-.7-2.7-.7-1.4 0-2.7.8-3.4 2-1.4 2.5-.4 6.3 1 8.3.7 1 1.5 2.1 2.6 2.1 1 0 1.4-.7 2.7-.7 1.2 0 1.6.7 2.7.6 1.1 0 1.8-1 2.5-2 .8-1.2 1.1-2.3 1.1-2.4-.1 0-2.2-.9-2.2-3.1ZM14.6 6.7c.6-.7 1-1.6.9-2.6-.8 0-1.9.6-2.5 1.3-.6.6-1 1.6-.9 2.5.9.1 1.9-.5 2.5-1.2Z"
			></path>
		</svg>
		<span class="flex flex-col leading-tight text-white">
			<span class={smallText + ' text-white/60 uppercase tracking-widest'}>Télécharger sur</span>
			<span class={bigText + ' font-bold'}>App Store</span>
		</span>
	</a>

	<a
		href={PLAY_STORE_URL}
		target="_blank"
		rel="noopener noreferrer"
		class:list={['glass-card flex items-center gap-3 no-underline hover:no-underline', pad]}
		aria-label="Télécharger Amikone sur Google Play"
	>
		<svg width={iconSize} height={iconSize} viewBox="0 0 24 24" aria-hidden="true">
			<path
				d="M4.2 2.6c-.3.3-.5.8-.5 1.4v16c0 .6.2 1.1.5 1.4l.1.1 9-9v-.2l-9-9-.1.1Z"
				fill="#7C4DFF"></path>
			<path
				d="m16.4 15.6-3.1-3.1v-.2l3.1-3.1.1.1 3.7 2.1c1 .6 1 1.6 0 2.2l-3.8 2Z"
				fill="#BB86FC"></path>
			<path
				d="m16.5 15.5-3.2-3.2-9.1 9.1c.3.4.9.4 1.5.1l10.8-6Z"
				fill="#6200EE"></path>
			<path
				d="M16.5 8.5 5.7 2.5c-.6-.3-1.2-.3-1.5.1l9.1 9.1 3.2-3.2Z"
				fill="#fff"></path>
		</svg>
		<span class="flex flex-col leading-tight text-white">
			<span class={smallText + ' text-white/60 uppercase tracking-widest'}>Disponible sur</span>
			<span class={bigText + ' font-bold'}>Google Play</span>
		</span>
	</a>
</div>
