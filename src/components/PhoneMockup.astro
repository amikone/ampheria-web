---
/**
 * Mockup de l'application Amikone, construit uniquement en CSS/SVG.
 * Reproduit l'écran "Swipe" du design system Dark Premium Glassmorphism.
 */
const passions = ['Randonnée', 'Cinéma', 'Cuisine'];
---

<div class="phone-glow relative mx-auto w-[280px] sm:w-[300px]">
	<div
		class="relative overflow-hidden rounded-[42px] border border-white/15 bg-gradient-to-b from-[#1e1e2c] to-[#121212] p-3 shadow-[0_30px_80px_rgba(0,0,0,0.6)]"
	>
		<!-- Encoche -->
		<div class="mx-auto mb-3 h-1.5 w-20 rounded-full bg-white/20"></div>

		<!-- Barre d'état -->
		<div class="mb-4 flex items-center justify-between px-1 text-[11px] text-white/60">
			<span>9:41</span>
			<span class="flex items-center gap-1">
				<svg width="14" height="10" viewBox="0 0 14 10" fill="currentColor" aria-hidden="true">
					<rect x="0" y="6" width="2.5" height="4" rx="1"></rect>
					<rect x="3.7" y="4" width="2.5" height="6" rx="1"></rect>
					<rect x="7.4" y="2" width="2.5" height="8" rx="1"></rect>
					<rect x="11.1" y="0" width="2.5" height="10" rx="1"></rect>
				</svg>
				<svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true">
					<rect x="0.5" y="0.5" width="14" height="9" rx="2.5" stroke="currentColor"></rect>
					<rect x="2" y="2" width="10" height="6" rx="1.5" fill="#7C4DFF"></rect>
					<rect x="16" y="3" width="2" height="4" rx="1" fill="currentColor"></rect>
				</svg>
			</span>
		</div>

		<!-- Carte profil -->
		<div class="glass-panel overflow-hidden">
			<div
				class="relative flex h-44 items-center justify-center bg-[radial-gradient(circle_at_30%_20%,rgba(124,77,255,0.55),rgba(194,24,93,0.25)_45%,rgba(30,30,44,0.9)_100%)]"
			>
				<div class="flex h-20 w-20 items-center justify-center rounded-full border-[3px] border-[rgba(124,77,255,0.5)] bg-white/10">
					<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" aria-hidden="true">
						<circle cx="12" cy="8.5" r="3.75"></circle>
						<path d="M4.5 20c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5" stroke-linecap="round"></path>
					</svg>
				</div>
				<span class="chip chip-active absolute left-3 top-3 text-[9px]!">Proche de vous</span>
			</div>

			<div class="p-4">
				<div class="flex items-baseline justify-between gap-2">
					<p class="m-0 text-[17px] font-bold text-white">Léa, 24 ans</p>
					<span class="text-[12px] text-white/50">à 3 km</span>
				</div>
				<p class="mt-1 text-[13px] leading-snug text-white/60">
					Toujours partante pour une rando ou un ciné-guignol.
				</p>
				<div class="mt-3 flex flex-wrap gap-1.5">
					{passions.map((passion) => <span class="chip text-[10px]!">{passion}</span>)}
				</div>

				<!-- Actions -->
				<div class="mt-4 flex items-center justify-center gap-4">
					<button
						type="button"
						class="flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white/70"
						aria-label="Passer le profil"
					>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
							<path d="M6 6l12 12M18 6L6 18"></path>
						</svg>
					</button>
					<button
						type="button"
						class="flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-[#7c4dff] to-[#6200ee] text-white shadow-[0_8px_30px_rgba(124,77,255,0.55)]"
						aria-label="Liker le profil"
					>
						<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path
								d="M12 20.4 10.7 19.2C6 14.9 3 12.2 3 8.9 3 6.2 5.1 4.1 7.7 4.1c1.5 0 3 .7 3.9 1.9l.4.5.4-.5c.9-1.2 2.4-1.9 3.9-1.9 2.6 0 4.7 2.1 4.7 4.8 0 3.3-3 6-7.7 10.3Z"
							></path>
						</svg>
					</button>
					<button
						type="button"
						class="flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white/70"
						aria-label="Enregistrer le profil"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
							<path d="M6 4h12v16l-6-4-6 4Z"></path>
						</svg>
					</button>
				</div>
			</div>
		</div>

		<!-- Barre de navigation -->
		<div class="mt-3 flex items-center justify-around px-4 pb-1 text-white/45">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
				<path d="M4 11.5 12 5l8 6.5V20a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1Z" stroke-linejoin="round"></path>
			</svg>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="#7C4DFF" aria-hidden="true">
				<path
					d="M12 20.4 10.7 19.2C6 14.9 3 12.2 3 8.9 3 6.2 5.1 4.1 7.7 4.1c1.5 0 3 .7 3.9 1.9l.4.5.4-.5c.9-1.2 2.4-1.9 3.9-1.9 2.6 0 4.7 2.1 4.7 4.8 0 3.3-3 6-7.7 10.3Z"
				></path>
			</svg>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
				<path d="M4 5.5h16v11H8.5L4.5 20v-3.5H4Z" stroke-linejoin="round"></path>
			</svg>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
				<circle cx="12" cy="8.5" r="3.75"></circle>
				<path d="M4.5 20c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5" stroke-linecap="round"></path>
			</svg>
		</div>
	</div>
</div>

<style>
	.phone-glow::before {
		content: '';
		position: absolute;
		inset: -18% -14%;
		background: radial-gradient(
			circle at 50% 50%,
			rgba(124, 77, 255, 0.45),
			transparent 65%
		);
		filter: blur(30px);
		z-index: -1;
	}

	@media (prefers-reduced-motion: no-preference) {
		.phone-glow {
			animation: float 7s ease-in-out infinite;
		}
	}

	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-14px);
		}
	}
</style>
