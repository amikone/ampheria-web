---
import BaseHead from '../../components/BaseHead.astro';
import BlogCard from '../../components/BlogCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import { withBase } from '../../utils';

const posts = (await getCollection('blog', (post) => !post.data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-6xl px-5 pb-24 pt-32">
			<header class="mb-12 max-w-3xl">
				<span class="chip chip-active">◆ Le blog Amikone</span>
				<h1 class="mt-5 text-[clamp(2rem,5vw,3.2rem)] font-bold leading-[1.08] tracking-tight">
					Actualités & notes de développement
				</h1>
				<p class="mt-3 text-[1.02rem] leading-relaxed text-white/65">
					Retours sur l'avancement du client Flutter, mises à jour
					communautaires, réflexions sur la rencontre libre et la
					décentralisation.
				</p>
			</header>

			{
				posts.length > 0 ? (
					<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
						{posts.map((post, index) => (
							<BlogCard post={post} size={index === 0 ? 'lg' : 'md'} />
						))}
					</div>
				) : (
					<div class="glass-card p-8 text-white/65">
						<p class="m-0">Aucun article publié pour le moment.</p>
					</div>
				)
			}
		</main>
		<Footer />
	</body>
</html>
