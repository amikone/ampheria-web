---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={`404 — ${SITE_TITLE}`} description="La page que vous cherchez n'existe pas." />
	</head>
	<body>
		<Header />
		<main class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-5 pb-20 pt-36 text-center">
			<span class="chip chip-active">Erreur 404</span>
			<h1 class="mt-5 text-[clamp(2.5rem,7vw,4rem)] font-bold leading-tight tracking-tight">
				Page introuvable
			</h1>
			<p class="mt-4 max-w-md text-[1.02rem] leading-relaxed text-white/60">
				La page que vous cherchez n'existe pas ou a été déplacée.
			</p>
			<div class="mt-8 flex flex-wrap justify-center gap-3">
				<a href={withBase('/')} class="btn btn-primary">Retour à l'accueil</a>
				<a href={withBase('/blog/')} class="btn btn-ghost">Lire le blog</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
