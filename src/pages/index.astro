---
import BaseHead from '../components/BaseHead.astro';
import BlogCard from '../components/BlogCard.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { GITHUB_APP_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import { withBase } from '../utils';

const features = [
	{
		title: 'Décentralisé & multi-instances',
		description:
			"Choisissez votre instance Supabase dans une liste communautaire, ou connectez votre propre serveur. Aucun monopole, aucune dépendance.",
		icon: 'globe',
	},
	{
		title: 'Un matching simple et fluide',
		description:
			"Profils riches, passions, galerie photos et le geste swipe que vous connaissez — sans que l'algorithme décide à votre place.",
		icon: 'heart',
	},
	{
		title: 'Messagerie temps réel',
		description:
			"Échangez instantanément avec vos matchs grâce à une messagerie instantanée connectée à votre instance.",
		icon: 'chat',
	},
	{
		title: 'Une identité maîtrisée',
		description:
			"Bio, passions, genre, orientation, préférences : votre profil vous ressemble et vous en gardez le contrôle total.",
		icon: 'badge',
	},
	{
		title: 'Géolocalisation au service du réel',
		description:
			"Trouvez des personnes proches selon votre rayon, et seulement si vous l'activez. Pas de revente de données.",
		icon: 'pin',
	},
	{
		title: 'Open source, de bout en bout',
		description:
			"Client Flutter et backend ouverts. Lisez le code, contribuez, proposez vos idées : le projet avance avec sa communauté.",
		icon: 'code',
	},
];

const steps = [
	{
		step: '01',
		title: 'Choisissez votre instance',
		description:
			"Liste communautaire chargée depuis GitHub, ou serveur personnalisé : vous décidez où vivent vos données.",
	},
	{
		step: '02',
		title: 'Composez votre identité',
		description:
			"Créez votre profil, ajoutez vos passions, votre galerie et vos préférences en quelques minutes.",
	},
	{
		step: '03',
		title: 'Swipez, matchez, discutez',
		description:
			"Découvrez des profils autour de vous, likez, et échangez en temps réel avec vos matchs.",
	},
];

const latestPosts = (await getCollection('blog', (post) => !post.data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const icons: Record<string, string> = {
	globe:
		'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-7.4 9h14.8M12 3c2.2 2.4 3.3 5.4 3.3 9S14.2 18.6 12 21c-2.2-2.4-3.3-5.4-3.3-9S9.8 5.4 12 3Z',
	heart:
		'M12 20.2 10.9 19.2C6.4 15.1 3.5 12.5 3.5 9.4 3.5 6.9 5.5 4.9 8 4.9c1.5 0 2.9.7 3.8 1.8l.2.3.2-.3c.9-1.1 2.3-1.8 3.8-1.8 2.5 0 4.5 2 4.5 4.5 0 3.1-2.9 5.7-7.4 9.8L12 20.2Z',
	chat: 'M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H9l-4 4v-4H6.5A2.5 2.5 0 0 1 4 13.5Z',
	badge:
		'M12 3.5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm-6.8 16c1-3.4 3.6-5.3 6.8-5.3s5.8 1.9 6.8 5.3',
	pin: 'M12 21s6.5-5.6 6.5-10.4A6.5 6.5 0 0 0 5.5 10.6C5.5 15.4 12 21 12 21Zm0-13.2a2.6 2.6 0 1 0 0 5.2 2.6 2.6 0 0 0 0-5.2Z',
	code: 'M8.5 8 4 12.2l4.5 4.2M15.5 8 20 12.2l-4.5 4.2M13.6 5l-3.2 14',
};
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<!-- ================================ HERO ================================ -->
		<section class="mx-auto max-w-6xl px-5 pb-20 pt-32 sm:pt-40">
			<div class="grid items-center gap-14 lg:grid-cols-[1.1fr_0.9fr]">
				<div>
					<span class="chip chip-active">Client open-source d'AmikOne</span>

					<h1
						class="mt-6 text-[clamp(2.5rem,6vw,4.2rem)] font-bold leading-[1.05] tracking-[-0.03em]"
					>
						La rencontre, <span class="text-gradient">enfin libre</span> et
						transparente.
					</h1>

					<p class="mt-6 max-w-xl text-[1.1rem] leading-relaxed text-white/65">
						{SITE_DESCRIPTION}
					</p>

					<div class="mt-9 flex flex-wrap items-center gap-3">
						<StoreButtons size="lg" />
					</div>

					<div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 text-[14px] text-white/50">
						<a
							href={GITHUB_APP_URL}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 text-white/70 no-underline transition hover:text-[color:var(--color-lavender)]"
						>
							<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
								<path
									d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
								></path>
							</svg>
							Voir le code source
						</a>
						<span class="hidden h-4 w-px bg-white/15 sm:block" aria-hidden="true"></span>
						<a
							href={withBase('/blog/')}
							class="text-white/70 no-underline transition hover:text-[color:var(--color-lavender)]"
						>
							Lire le blog →
						</a>
					</div>
				</div>

				<div class="relative flex justify-center lg:justify-end">
					<PhoneMockup />
				</div>
			</div>

			<!-- Bandeau de valeurs -->
			<div class="mt-16 flex flex-wrap items-center justify-center gap-3">
				<span class="chip">Open source</span>
				<span class="chip">Multi-instances</span>
				<span class="chip">Sans publicité</span>
				<span class="chip">Vie privée respectée</span>
				<span class="chip">Flutter + Supabase</span>
			</div>
		</section>

		<!-- ============================= FONCTIONNALITÉS ======================== -->
		<section id="fonctionnalites" class="mx-auto max-w-6xl px-5 py-20">
			<div class="mb-12 max-w-3xl">
				<span class="section-eyebrow">◆ Fonctionnalités clés</span>
				<h2 class="section-title">Tout ce qu'on attend d'une rencontre moderne.</h2>
				<p class="section-subtitle">
					Amikone réunit l'essentiel des applications de rencontre — avec en plus
					la transparence et la liberté de choisir son propre serveur.
				</p>
			</div>

			<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{
					features.map((feature) => (
						<div class="glass-card flex h-full flex-col gap-4 p-7">
							<div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-[rgba(124,77,255,0.4)] bg-[rgba(124,77,255,0.15)] text-[color:var(--color-lavender)]">
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d={icons[feature.icon]} />
								</svg>
							</div>
							<h3 class="m-0 text-[1.15rem] leading-snug text-white">
								{feature.title}
							</h3>
							<p class="m-0 text-[15px] leading-relaxed text-white/60">
								{feature.description}
							</p>
						</div>
					))
				}
			</div>
		</section>

		<!-- ============================= COMMENT ÇA MARCHE ====================== -->
		<section id="fonctionnement" class="mx-auto max-w-6xl px-5 py-20">
			<div class="glass-panel overflow-hidden">
				<div class="grid gap-10 p-8 sm:p-12 lg:grid-cols-[0.9fr_1.1fr]">
					<div>
						<span class="section-eyebrow">◆ Comment ça marche</span>
						<h2 class="section-title">Trois étapes, zéro tracking.</h2>
						<p class="section-subtitle">
							Pas de compte publicitaire, pas d'abonnement caché : vous installez
							l'application, vous choisissez votre instance, et vous êtes maître de
							votre expérience.
						</p>

						<a href={withBase('/#download')} class="btn btn-primary mt-8">
							Télécharger l'application
						</a>
					</div>

					<ol class="m-0 flex list-none flex-col gap-4 p-0">
						{
							steps.map((item) => (
								<li class="flex gap-5 rounded-card border border-white/10 bg-white/5 p-5">
									<span class="text-[1.6rem] font-bold leading-none text-[color:var(--color-accent)]">
										{item.step}
									</span>
									<div>
										<h3 class="m-0 text-[1.05rem] text-white">{item.title}</h3>
										<p class="mt-1.5 text-[15px] leading-relaxed text-white/60">
											{item.description}
										</p>
									</div>
								</li>
							))
						}
					</ol>
				</div>
			</div>
		</section>

		<!-- ============================== DERNIERS ARTICLES ===================== -->
		<section id="blog" class="mx-auto max-w-6xl px-5 py-20">
			<div class="mb-10 flex flex-wrap items-end justify-between gap-4">
				<div class="max-w-2xl">
					<span class="section-eyebrow">◆ Le blog</span>
					<h2 class="section-title">Dernières publications</h2>
					<p class="section-subtitle">
						Notes de développement, guides et réflexions sur la rencontre
						libre.
					</p>
				</div>
				<a
					href={withBase('/blog/')}
					class="btn btn-ghost"
				>
					Tous les articles
				</a>
			</div>

			{
				latestPosts.length > 0 ? (
					<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
						{latestPosts.map((post) => (
							<BlogCard post={post} />
						))}
					</div>
				) : (
					<p class="text-white/60">Le blog arrive bientôt.</p>
				)
			}
		</section>

		<!-- ================================ TÉLÉCHARGER ======================== -->
		<section id="download" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-20">
			<div class="relative overflow-hidden rounded-glass border border-white/10 bg-[rgba(42,42,62,0.5)] px-6 py-14 text-center backdrop-blur-xl sm:px-14">
				<div
					class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-[rgba(124,77,255,0.45)] blur-[90px]"
					aria-hidden="true"
				></div>
				<div
					class="pointer-events-none absolute -bottom-28 -right-16 h-72 w-72 rounded-full bg-[rgba(194,24,93,0.3)] blur-[90px]"
					aria-hidden="true"
				></div>

				<div class="relative">
					<span class="chip chip-active">Gratuit, sans pub</span>
					<h2 class="mx-auto mt-6 max-w-2xl text-[clamp(1.9rem,4vw,2.75rem)] leading-tight tracking-tight text-white">
						Rejoignez l'aventure Amikone
					</h2>
					<p class="mx-auto mt-4 max-w-xl text-[1.05rem] leading-relaxed text-white/65">
						Disponible sur iOS et Android. Faites-nous un retour sur les stores,
						c'est précieux pour faire avancer le projet.
					</p>

					<div class="mt-9 flex justify-center">
						<StoreButtons size="lg" />
					</div>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>
